#!/bin/sh

#source var/function
. ./function.sh
inst_launch_workaround

PATH=./:$PATH
LOG_DIR="./log"

print_start() {
	#    more << EOF
	echo "rAthena is starting..."
	echo "            (c) 2021 rAthena Project"
	echo ""
	echo ""
	echo "checking..."
	#EOF
}

get_status(){
	PIDFILE=.$1.pid
	PSRUN=
	if [ -e ${PIDFILE} ]; then
		PSRUN=$(pgrep -F ${PIDFILE} 2>/dev/null)
	fi
	#return ${PSRUN} #seems to cause an issue for some os
}

# List PIDs of "$1" (e.g. map-server) that were launched from THIS directory
# but are NOT the pid recorded in .$1.pid — i.e. orphans left behind by a
# crashed/detached launcher or a clobbered pid file. cwd match keeps this from
# ever touching a server belonging to a different rAthena install on the box.
list_orphans(){
	_srv=$1
	_tracked=
	[ -e ".${_srv}.pid" ] && _tracked=$(cat ".${_srv}.pid" 2>/dev/null)
	_here=$(pwd -P)
	for _p in $(pgrep -x "${_srv}" 2>/dev/null); do
		[ "${_p}" = "${_tracked}" ] && continue
		_pcwd=$(readlink -f "/proc/${_p}/cwd" 2>/dev/null)
		[ "${_pcwd}" = "${_here}" ] && echo "${_p}"
	done
}


# --- multi-core map sharding -------------------------------------------------
# Two map-server processes, one pinned per CPU core, owning disjoint map sets:
#   map-server   -> conf/map_athena_a.conf  (all maps except conf/maps_b.conf)  core 0
#   map-server2  -> conf/map_athena_b.conf (only conf/maps_b.conf)             core 1
# Both connect to the same char-server (6121) / DB. See conf/maps_b*.conf.
NCPU=$(nproc 2>/dev/null || echo 1)
srv_prefix(){  # echoes a "taskset -c N" prefix, or nothing if only 1 cpu / no taskset
	[ "$NCPU" -ge 2 ] || { echo ""; return; }
	command -v taskset >/dev/null 2>&1 || { echo ""; return; }
	case "$1" in
		map-server)  echo "taskset -c 0 " ;;
		map-server2) echo "taskset -c 1 " ;;
		*)           echo "" ;;
	esac
}
srv_args(){     # echoes extra CLI args for a given server name
	case "$1" in
		map-server)  echo "--map-config conf/map_athena_a.conf" ;;
		map-server2) echo "--map-config conf/map_athena_b.conf" ;;
		*)           echo "" ;;
	esac
}

# The extra sharded map instances (map-server2, ...) are not build outputs -
# they are hardlinks to the freshly built ./map-server so each carries a
# distinct process name for pgrep / taskset. Recreate them from M_SRV up-front,
# BEFORE check_files() runs, so a fresh build / cleaned tree / removed link
# never aborts startup with "map-server2 does not exist". Idempotent.
ensure_map_shards(){
	[ -f ./map-server ] || return 0
	for _m in ${M_SRV}; do
		[ "${_m}" = "map-server" ] && continue
		ln -f ./map-server "./${_m}" 2>/dev/null
	done
}
# ---------------------------------------------------------------------------

#checking if already started, launch and mark in log
start_serv(){
	# map-server2 is the same binary as map-server, hardlinked so it has a
	# distinct process name for pgrep / taskset. Refresh it before every start
	# so it never lags behind a rebuild of map-server.
	if [ "$1" = "map-server2" ] && [ -f ./map-server ]; then ln -f ./map-server ./map-server2 2>/dev/null; fi
	# Reap orphans from this directory before (re)starting so instances never
	# stack up across crashes / bad shutdowns (see list_orphans).
	for _op in $(list_orphans $1); do
		echo "WARNING: orphan '$1' (pid ${_op}) from a previous run detected - terminating it"
		kill ${_op} 2>/dev/null
		_w=0
		while kill -0 ${_op} 2>/dev/null && [ ${_w} -lt 15 ]; do sleep 1; _w=$((_w+1)); done
		kill -0 ${_op} 2>/dev/null && { echo "  orphan ${_op} did not exit, sending KILL"; kill -9 ${_op} 2>/dev/null; }
	done
	get_status $1
	if [ $2 ]; then #is logging on ?
		LOGFILE="$LOG_DIR/$1.launch.log"
		LOGRUN="$LOG_DIR/$1.log"
		FIFO="$1_fifo"
		echo "stat_serv, log is enabled"
		echo "My logfile=${LOGFILE}"
		if [ -z ${PSRUN} ]; then
			if [ -e ./${FIFO} ]; then rm -f "$FIFO"; fi
			mkfifo "$FIFO"; tee "$LOGRUN" < "$FIFO" & $(srv_prefix "$1")"./$1" $(srv_args "$1") > "$FIFO" 2>&1 & PID=$!
			#"./$1" > >(tee "$LOGRUN") 2>&1 & PID=$! #bash only
			echo "$PID" > .$1.pid
			echo "Server '$1' started at $(date +"%m-%d-%H:%M-%S")" | tee ${LOGFILE}
		else
			echo "Cannot start '$1', because it is already running p${PSRUN}" | tee ${LOGFILE}
		fi
	else
		if [ -z ${PSRUN} ]; then
			$(srv_prefix "$1")./$1 $(srv_args "$1") &
			echo "$!" > .$1.pid
			echo "Server '$1' started at $(date +"%m-%d-%H:%M-%S")"
		else
			echo "Cannot start '$1', because it is already running p${PSRUN}"
		fi
	fi
}

watch_serv(){
	ulimit -Sc unlimited

	#now checking status and looping
	count=0;
	while true; do
		for i in ${L_SRV} ${C_SRV} ${M_SRV} ${W_SRV}
		do
			LOGFILE="$LOG_DIR/$i.launch.log"
			LOGRUN="$LOG_DIR/$i.log"
			FIFO=$i"_fifo"

			get_status ${i}
			#echo "Echo id of $i is ${PSRUN}"
			if [ -z ${PSRUN} ]; then
				count=$((count+1))
				#echo "fifo=$FIFO"
				echo "server '$i' is down"
				echo "server '$i' is down" >> ${LOGFILE}
				echo "restarting server at time at $(date +"%m-%d-%H:%M-%S")"
				echo "restarting server at time at $(date +"%m-%d-%H:%M-%S")" >> ${LOGFILE}
				if [ -e $FIFO ]; then rm -f "$FIFO"; fi
				mkfifo "$FIFO"; tee "$LOGRUN" < "$FIFO" & $(srv_prefix "$i")"./$i" $(srv_args "$i") > "$FIFO" 2>&1 & PID=$!
				echo "$PID" > .$i.pid
				if [ $2 ] && [ $2 -lt $count ]; then break; fi
			fi
		done
		sleep $1
	done
}

restart(){
	$0 stop
	if [ $1 ]; then sleep $1; fi
	for i in ${L_SRV} ${C_SRV} ${M_SRV} ${W_SRV}
	do
		FIFO="$1_fifo"
		while true; do
			get_status ${i}
			if [ ${PSRUN} ]; then echo "'${i}' is still running p${PSRUN} waiting for the process to end"; sleep 2;
			else 
				if [ -e ./${FIFO} ]; then rm -f "$FIFO"; fi
				break
			fi
		done
	done
	$0 start
}

case $1 in
	'start')
		print_start
		ensure_map_shards
		check_files
		echo "Check complete."
		echo "Looks like a good, nice rAthena!"
		if [ "$2" = "--enlog" ]; then
		 ENLOG=1
		 if [ ! -d "$LOG_DIR" ]; then mkdir -p $LOG_DIR; fi
		 echo "Logging is enabled in $LOG_DIR"
		else
		 echo "Logging is disabled"
		fi
		for i in ${L_SRV} ${C_SRV} ${M_SRV} ${W_SRV}
		do
			start_serv $i $ENLOG
		done
		echo "rAthena was started."
	;;
	'watch')
		ensure_map_shards
		if [ ! -d "$LOG_DIR" ]; then mkdir -p $LOG_DIR; fi
		if [ -z $2 ]; then Restart_count=10; else Restart_count=$2; fi
		if [ -z $3 ]; then Restart_sleep=3; else Restart_sleep=$3; fi
		echo "Going to watch rAthena for restart_count = $Restart_count, restart_sleep = $Restart_sleep"
		for i in ${L_SRV} ${C_SRV} ${M_SRV} ${W_SRV}
		do
			start_serv $i 1
		done
		watch_serv $Restart_count $Restart_sleep
		echo "Watching rAthena now."
	;;
	'stop')
		for i in ${W_SRV} ${M_SRV} ${C_SRV} ${L_SRV}
		do
			PIDFILE=.${i}.pid
			if [ -e ./${PIDFILE} ]; then
				_pid=$(cat ${PIDFILE} 2>/dev/null)
				# The recorded process may already be gone (crash, prior kill).
				# Guard so a dead pid does not spew "kill: No such process".
				if [ -n "${_pid}" ] && kill -0 ${_pid} 2>/dev/null; then
					kill ${_pid} 2>/dev/null

					while true; do
						get_status ${i}
						if [ ${PSRUN} ]; then echo "'${i}' is still running p${PSRUN} waiting for the process to end"; sleep 2;
						else
							break
						fi
					done
				else
					echo "'${i}' pid ${_pid:-?} in ${PIDFILE} is not running - clearing stale pid file"
				fi

				# -f: pid files can end up write-protected; plain rm then prompts
				# interactively and hangs a non-interactive stop.
				rm -f ${PIDFILE}
			fi
			# Also clear any orphan of this server started from this directory
			# but not tracked by the pid file.
			for _op in $(list_orphans ${i}); do
				echo "'${i}' orphan pid ${_op} not in pid file - terminating"
				kill ${_op} 2>/dev/null
				_w=0
				while kill -0 ${_op} 2>/dev/null && [ ${_w} -lt 15 ]; do sleep 1; _w=$((_w+1)); done
				kill -0 ${_op} 2>/dev/null && kill -9 ${_op} 2>/dev/null
			done
		done
	;;
	'restart')
		 restart "$@"
	;;
	'status')
		for i in ${L_SRV} ${C_SRV} ${M_SRV} ${W_SRV}
		do
			get_status ${i}
			if [ ${PSRUN} ]; then echo "'${i}' is running p${PSRUN}"; else echo "'${i}' seems to be down"; fi
		done
	;;
	'val_runonce')
		for i in ${L_SRV} ${C_SRV} ${M_SRV} ${W_SRV}
		do
			valgrind --leak-check=full --show-leak-kinds=all ./$i --run-once > "log/$i.runonce.leak"
		done
	;;
	'valchk')
		for i in ${L_SRV} ${C_SRV} ${M_SRV} ${W_SRV}
		do
			valgrind --leak-check=full --show-leak-kinds=all ./$i > "log/$i.runonce.leak"
		done
	;;
	'help')
		case $2 in
			'start')
				echo "syntax: 'start {--enlog}'"
				echo "This option will start the servers"
				echo "--enlog will write all terminal output into a log/\$servname.log file"
			;;
			'stop')
				echo "This option will shut the servers down"
			;;
			'restart')
				echo "syntax: 'restart {<delay>}'"
				echo "This option will wait for the given delay and will attempt to restart the servers afterwards"
				echo "Note: Even if the delay is over it will wait until the pid is finished before attempting to restart the servers"
			;;
			'status')
				echo "syntax: 'status'"
				echo "This option will let you know whether the server are running or not"
				echo "Note: This option is based on PID and requires that you have launched the servers with this script too"
				echo "If this was not the case please use something like 'ps ax | grep server' to check their status"
			;;
			'watch')
				echo "syntax: 'watch {<restart_interval> <restart_count>}'"
				echo "The watch option allows you to automatically restart the servers when one of them was stopped"
				echo "<restart_interval> delay in seconds before rechecking if a server is down (default 10) "
				echo "<restart_count> how many times the servers should be restarted (default 3), (-1=indefinitly)"
			;;
			'val_runonce')
				echo "syntax: 'val_runonce'"
				echo "This option will run valgrind with run-once to check the servers"
			;;
			'valchk')
				echo "syntax: 'valchk'"
				echo "This option will run valgrind with the servers"
			;;
			*)
				echo "Please specify a command you would like more info on { start | stop | restart | status | watch }"
				read -p "Enter a valid command: " readEnterKey
				$0 "help" $readEnterKey
			;;
		esac
	;;
	*)
		echo "Usage: athena-start { start | stop | restart | status | watch | help | val_runonce | valchk }"
		read -p "Enter a valid option: " readEnterKey
		$0 $readEnterKey
	;;
esac


